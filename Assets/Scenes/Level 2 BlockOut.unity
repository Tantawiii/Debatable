  m_Script: {fileID: 11500000, guid: 5c9e3f1b7d4062c3eaf8d6f4b2c9e153, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - id: l2_01_a
    clip: {fileID: 8300000, guid: 55678048bb2495147af1cfb06f63f4ec, type: 3}
    caption: Phew! That was painful man, but you got through huh!
    gapAfter: 0.35
    captionOnlySeconds: 3.45
  - id: l2_01_b
    clip: {fileID: 8300000, guid: a76fb0565d85787419f30825829b018d, type: 3}
    caption: Well seems we hit another crazy ride.
    gapAfter: 0.35
    captionOnlySeconds: 3.6
  - id: l2_01_c
    clip: {fileID: 8300000, guid: c9ad3090169b29849a71b6e4d4670e13, type: 3}
    caption: This is just in this was a maze, I was informed so by Game Designer
      with ONE Exit direct. No tricks. ...Probably.
    gapAfter: 0.3
    captionOnlySeconds: 2.75
  once: 1
  firstRunOnly: 1
  priority: 0
