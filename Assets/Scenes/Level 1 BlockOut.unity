  lines:
  - id: l1_01_a
    clip: {fileID: 8300000, guid: 103da03799c759b429e9de55acc11c95, type: 3}
    caption: Oh! Hello there. I am your first time in game helper, call me Narrator.
    gapAfter: 0.35
    captionOnlySeconds: 2.8
  - id: l1_01_b
    clip: {fileID: 8300000, guid: 5c9082bd7cd559d46a03b59a28b1c62a, type: 3}
    caption: Seems you are new here, let me help out
    gapAfter: 0.4
    captionOnlySeconds: 4.4
  - id: l1_01_c
    clip: {fileID: 8300000, guid: cc4c9516088e8d04c99cff17efb24734, type: 3}
    caption: Use W to move forward. A to move left. S to move backward. D to move
      right.
    gapAfter: 0.3
    captionOnlySeconds: 2.95
  once: 1
  firstRunOnly: 1
  priority: 0
